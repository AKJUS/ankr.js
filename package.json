{
  "name": "@ankr.com/ankr.js",
  "keywords": [
    "ankr",
    "ankrscan",
    "blockchain",
    "sdk"
  ],
  "version": "0.7.0",
  "description": "Compact library for interacting with Ankr APIs.",
  "main": "./dist/index.js",
  "files": [
    "dist/*"
  ],
  "type": "commonjs",
  "scripts": {
    "pub": "yarn typecheck && yarn test && tsc && yarn version && yarn publish",
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "start": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "yarn typecheck && yarn test"
  },
  "repository": "https://github.com/w3tech/ankr.js.git",
  "author": "Ankr",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.18.1"
  },
  "devDependencies": {
    "tsx": "^4.23.1",
    "typescript": "^4.6.2"
  }
}
